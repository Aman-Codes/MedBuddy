                <div class="button-bn">
                  <a href="/view2">Read More <i class="fa fa-chevron-circle-right"></i></a>
                </div>
              </div>
            </div>
          </div>
          <div class="col-lg-4 col-md-6">
            <div class="services-item effect-item">
              <a href="/view2" class="image-effect">
                <div class="services-photo" style="background-image: url(assets/images/lab.JPEG)"></div>
              </a>
              <div class="services-text">
                <h3><a href="/view2">Modern Laboratory</a></h3>
                <p>
                  Access modern, well-equipped labs for diagnostics with accurate and timely reports.
                </p>
                <div class="button-bn">
                  <a href="/view2">Read More <i class="fa fa-chevron-circle-right"></i></a>
                </div>
              </div>
            </div>
          </div>
          <div class="col-lg-4 col-md-6">
            <div class="services-item effect-item">
              <a href="/view2" class="image-effect">
                <div class="services-photo" style="background-image: url(assets/images/test.JPEG)"></div>
              </a>
              <div class="services-text">
                <h3><a href="/view2">All Major Tests</a></h3>
                <p>
                  Routine, advanced, and specialty medical tests under one roof.
                </p>
                <div class="button-bn">
                  <a href="/view2">Read More <i class="fa fa-chevron-circle-right"></i></a>
                </div>
              </div>
            </div>
          </div>
          <div class="col-lg-4 col-md-6">
            <div class="services-item effect-item">
              <a href="/view2" class="image-effect">
                <div class="services-photo" style="background-image: url(assets/images/dental.JPEG)"></div>
              </a>
              <div class="services-text">
                <h3><a href="/view2">Dental Care</a></h3>
                <p>
                  Preventive and corrective dental procedures tailored to patient needs.
                </p>
                <div class="button-bn">
                  <a href="/view2">Read More <i class="fa fa-chevron-circle-right"></i></a>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <!--Services End-->

    <!-- TESTIMONIALS Start-->
