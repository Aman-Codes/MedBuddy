                </div>
                <div class="testimonial-name">ANNA ITURBE</div>
              </div>
              <!--TESTIMONIAL 2 END-->

              <!--TESTIMONIAL 3 -->
              <div class="item">
                <div class="shadow-effect">
                  <img class="img-circle" src="assets/images/pat3.JPEG" alt="user3">
