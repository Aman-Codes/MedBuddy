<!DOCTYPE html>
<html lang="en">
  <head>
    <!--Meta Data-->
    <%- include('partial/title.ejs'); %> 

    <% if (data.NODE_ENV == 'production') { %>
      <!-- Production Stylesheets -->
      <link rel="stylesheet" href="assets/production/css/home.min.css">
    <% } else { %>
      <!-- Development Stylesheets -->
      <link rel="stylesheet" href="assets/lib/css/bootstrap.min.css">
      <link rel="stylesheet" href="assets/lib/css/fontawesome.min.css">
      <link rel="stylesheet" href="assets/lib/css/responsive.css">
      <link rel="stylesheet" href="assets/lib/css/select2.min.css">
      <link rel="stylesheet" href="assets/lib/css/spacing.css">
      <link rel="stylesheet" href="assets/lib/css/style.css">
      <link rel="stylesheet" href="assets/lib/css/owl.carousel.min.css">
      <link rel="stylesheet" href="assets/lib/css/owl.theme.default.min.css">
      <link rel="stylesheet" href="assets/lib/css/bootstrap-datepicker.min.css">
      <link rel="stylesheet" href="assets/lib/css/magnific-popup.css">
      <link rel="stylesheet" href="assets/css/home.css">
      <link rel="stylesheet" href="assets/css/header.css">
    <% } %>
  </head>

  <body onLoad="typeWriter()">
    <!--Header-->
    <%- include('partial/header.ejs', {data: data }); %>

    <!--Banner Start-->
    <div class="banner-slider" style="background-image: url(/assets/images/banner.JPEG)">
      <div class="bg"></div>
      <div class="bannder-table">
        <div class="banner-text">
          <h1 id="typeit"> </h1>
        </div>
      </div>
    </div>
    <!--Banner End-->

    <!--About Start-->
    <div class="about-area pt_60 pb_90">
      <div class="container">
        <div class="row">
          <div class="col-lg-6 mt_30">
            <div class="about-content">
              <div class="headline-left">
                <h2>
                  <span>QUALITY MEDICAL SERVICES</span> MAKE OUR PATIENTS HAPPY
                </h2>
              </div>
              <p>
                Carebridge is your trusted digital healthcare partner, committed to simplifying access to quality medical services. Designed for patients, doctors, and hospital staff, Carebridge bridges the gap between care and convenience.
              </p>
              <div class="progress-gallery main-prog">
                <div class="bar-container">
                  <p>Neurology</p>
                  <div class="progress">
                    <div class="progress-bar progress-bar-success progress-bar-custom" role="progressbar" aria-valuenow="95" aria-valuemin="0" aria-valuemax="100" style="width: 95%">
                    </div>
                  </div>
                  <div class="percentage-show">95%</div>
                </div>
                <div class="bar-container">
                  <p>Dentistry</p>
                  <div class="progress">
                    <div class="progress-bar progress-bar-success progress-bar-custom" role="progressbar" aria-valuenow="80" aria-valuemin="0" aria-valuemax="100" style="width: 80%">
                    </div>
                  </div>
                  <div class="percentage-show">80%</div>
                </div>
                <div class="bar-container">
                  <p>Radiology</p>
                  <div class="progress">
                    <div class="progress-bar progress-bar-success progress-bar-custom" role="progressbar" aria-valuenow="88" aria-valuemin="0" aria-valuemax="100" style="width: 88%">
                    </div>
                  </div>
                  <div class="percentage-show">88%</div>
                </div>
                <div class="bar-container">
                  <p>Cardiology</p>
                  <div class="progress">
                    <div class="progress-bar progress-bar-success progress-bar-custom" role="progressbar" aria-valuenow="82" aria-valuemin="0" aria-valuemax="100" style="width: 82%">
                    </div>
                  </div>
                  <div class="percentage-show">82%</div>
                </div>
              </div>
            </div>
          </div>
          <div class="m-auto">
            <iframe width="560" height="315" src="https://www.youtube.com/embed/-Fdo_HT3X80"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen></iframe>
          </div>
        </div>
      </div>
    </div>
    <!--About End-->

    <!--Choose-Area Start-->
    <div class="choose-area pb_90">
      <div class="container">
        <div class="row">
          <div class="col-12">
            <div class="headline">
              <h2>WHY CHOOSE US</h2>
              <h3>We have some special criteria that will help you</h3>
            </div>
          </div>
        </div>
        <div class="row">
          <div class="col-lg-4">
            <div class="choose-item flex" style="background-image: url(assets/images/cloak.JPEG)">
              <div class="choose-icon">
                <i class="fas fa-clock fa-3x" aria-hidden="true"></i>
              </div>
              <div class="choose-text">
                <h4>QUICK RESPONSE</h4>
                <p>
                  Carebridge ensures fast access to healthcare services—whether it's booking an appointment, contacting support, or receiving updates. We minimize wait times and prioritize immediate attention to your needs.
                </p>
              </div>
            </div>
          </div>
          <div class="col-lg-4">
            <div class="choose-item flex" style="background-image: url(assets/images/satisfication.JPEG)">
              <div class="choose-icon">
                <i class="fa fa-thumbs-up fa-3x" aria-hidden="true"></i>
              </div>
              <div class="choose-text">
                <h4>100% SATISFACTION</h4>
                <p>
                  We are committed to delivering a smooth and dependable healthcare experience. From login to consultation, every step is designed with your comfort and satisfaction in mind.
                </p>
              </div>
            </div>
          </div>
          <div class="col-lg-4">
            <div class="choose-item flex" style="background-image: url(assets/images/qualityservice.JPEG)">
              <div class="choose-icon">
                <i class="fa fa-globe fa-3x" aria-hidden="true"></i>
              </div>
              <div class="choose-text">
                <h4>QUALITY SERVICE</h4>
                <p>
                  Carebridge connects you with trusted doctors and services while maintaining high standards of care, accuracy, and privacy across the platform.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <!--Choose-Area End-->

    <!--Feature-Area Start-->
    <div class="feature-area feature-two bg-area pt_90 pb_90">
      <div class="container">
        <div class="row">
          <div class="col-12">
            <div class="headline">
              <h2>SPECIAL FEATURES</h2>
              <h3>We offer some awesome features that will help you</h3>
            </div>
          </div>
        </div>
        <div class="row">
          <div class="col-lg-4 col-md-6">
            <div class="feature-item">
              <div class="feature-icon">
                <br>
                <i class="fas fa-hospital-alt fa-3x" aria-hidden="true"></i>
              </div>
              <div class="feature-text">
                <h4>Planned Space Design</h4>
                <p>
                  Our facilities are designed for efficiency, ensuring a seamless experience for patients and healthcare providers.
                </p>
              </div>
            </div>
          </div>
          <div class="col-lg-4 col-md-6">
            <div class="feature-item">
              <div class="feature-icon">
                <br>
                <i class="fas fa-procedures fa-3x" aria-hidden="true"></i>
              </div>
              <div class="feature-text">
                <h4>Good Medical Facilities</h4>
                <p>
                  Access to advanced medical equipment and skilled professionals for top-notch care.
                </p>
              </div>
            </div>
          </div>
          <div class="col-lg-4 col-md-6">
            <div class="feature-item">
              <div class="feature-icon">
                <br>
                <i class="fas fa-ambulance fa-3x" aria-hidden="true"></i>
              </div>
              <div class="feature-text">
                <h4>Best Ambulance Service</h4>
                <p>
                  Quick and reliable ambulance services for emergency situations, ensuring timely transport.
                </p>
              </div>
            </div>
          </div>
          <div class="col-lg-4 col-md-6">
            <div class="feature-item">
              <div class="feature-icon">
                <br>
                <i class="fas fa-laptop-medical fa-3x" aria-hidden="true"></i>
              </div>
              <div class="feature-text">
                <h4>Computerized Platform</h4>
                <p>
                  A user-friendly digital platform for seamless appointment booking and health record management.
                </p>
              </div>
            </div>
          </div>
          <div class="col-lg-4 col-md-6">
            <div class="feature-item">
              <div class="feature-icon">
                <br>
                <i class="fas fa-stethoscope fa-3x" aria-hidden="true"></i>
              </div>
              <div class="feature-text">
                <h4>Reduced Supervision</h4>
                <p>
                  Streamlined processes to minimize oversight and enhance patient autonomy.
                </p>
              </div>
            </div>
          </div>
          <div class="col-lg-4 col-md-6">
            <div class="feature-item">
              <div class="feature-icon">
                <br>
                <i class="fas fa-robot fa-3x" aria-hidden="true"></i>
              </div>
              <div class="feature-text">
                <h4>Modern Technology</h4>
                <p>
                  Leveraging AI and telemedicine to provide cutting-edge healthcare solutions.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <!--Feature-Area End-->

    <!--Services Start-->
